# GenJSA — copy this file to .env and fill in real values
# .env is in .gitignore — never commit it to git

# On Render: set these in the Dashboard → Environment tab, no .env file needed

# ThaiLLM API key (required)
THAILLM_API_KEY=

# Port the backend listens on — Render supplies $PORT automatically at deploy time
PORT=8000
